{
    "variables": [
        {
            "name": "PACKAGE_NAME",
            "type": "string",
            "description": "Name of the package",
            "value_example": "view_robot",
            "access": "user input"
        },
        {
            "name": "PACKAGE_VERSION",
            "type": "string",
            "type_description": "semver string (https://semver.org/) like 0.0.1-stable",
            "validation": "semver",
            "description": "Version of the package in semantic versioning (https://semver.org/)",
            "value_example": "0.0.1-stable",
            "access": "user input"
        },
        {
            "name": "PACKAGE_DESCRIPTION",
            "type": "string",
            "description": "Description of the package, a free text",
            "value_example": "A work space package to view a robot defined by an URDF with rviz",
            "access": "user input"
        },
        {
            "name": "PACKAGE_MAINTAINER_EMAIL",
            "type": "string",
            "validation": "email",
            "description": "Email of the maintainer",
            "value_example": "maintainer@gmail.com",
            "access": "user input"
        },
        {
            "name": "PACKAGE_MAINTAINER_NAME",
            "type": "string",
            "description": "Full name of the maintainer, first name in lower case, capitalized and last name in upper case",
            "value_example": "Manuel YGUEL",
            "access": "user input"
        },
        {
            "name": "PACKAGE_LICENSE",
            "type": "[\"Apache-2.0\",\"BSL-1.0\",\"BSD-2.0\",\"BSD-2-Clause\",\"BSD-3-Clause\",\"GPL-3.0-only\",\"LGPL-3.0-only\",\"MIT\",\"MIT-0\"]",
            "validation": "license",
            "normalize": "license",
            "description": "License of the package, one of the known licenses [\"Apache-2.0\",\"BSL-1.0\",\"BSD-2.0\",\"BSD-2-Clause\",\"BSD-3-Clause\",\"GPL-3.0-only\",\"LGPL-3.0-only\",\"MIT\",\"MIT-0\"]",
            "value_example": "MIT",
            "access": "user input"
        },
        {
            "name": "YEAR",
            "type": "int",
            "description": "Year of the creation",
            "function": "current_year",
            "value_example": 2023,
            "access": "function"
        },
        {
            "name": "LABORATORY",
            "type": "string",
            "description": "Name of the laboratory for copyright",
            "value_example": "Robotics Laboratory",
            "access": "user input"
        },
        {
            "name": "LICENSE_TEXT",
            "type": "string",
            "function": "license_reference",
            "description": "Text of the license, corresponding to one of the specified licenses",
            "value_example": "Standard MIT License Text",
            "access": "function"
        },
        {
            "name": "ROBOT_NAME",
            "type": "string",
            "description": "Name of the robot model",
            "value_example": "my_robot",
            "access": "user input"
        }
    ]
}